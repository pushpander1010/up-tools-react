[Unit]
Description=Laya Decision API
After=network.target
[Service]
User=opc
WorkingDirectory=/home/opc/oracle-laya-backend
Environment=LAYA_MODEL=convaiinnovations/laya
ExecStart=/home/opc/laya-env/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
[Install]
WantedBy=multi-user.target
